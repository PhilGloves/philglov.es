{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm preview --var SITE_ENV:production",
      "startServerReadyPattern": "Ready on",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://127.0.0.1:8787/",
        "http://127.0.0.1:8787/it",
        "http://127.0.0.1:8787/journal",
        "http://127.0.0.1:8787/lisbona",
        "http://127.0.0.1:8787/photos/lisbon",
        "http://127.0.0.1:8787/photos/lisbon/tram-28"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "onlyCategories": ["seo"],
        "chromeFlags": "--headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:seo": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "pessimistic"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-seo"
    }
  }
}
