---
import LanguageLabel from "../components/LanguageLabel.astro";
import Photo from "../components/Photo.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
/** Standalone pages: About, Now, Rights, Privacy (the page template in /styleguide). */
import { render } from "astro:content";
import site from "../data/site.json" with { type: "json" };
import { t, tf, type Locale } from "../i18n";
import { type PageEntry } from "../lib/collections.ts";
import { isoDate, pathFor } from "../lib/entries.ts";
import { personJsonLd } from "../lib/seo.ts";

interface Props {
  locale: Locale;
  slug: string;
  page: PageEntry;
  hasTwin: boolean;
}

const { locale, slug, page, hasTwin } = Astro.props;
const { Content } = await render(page);
const path = pathFor(locale, `/${slug}`);
const current = slug === "now" || slug === "about" ? slug : undefined;
const isAbout = slug === "about";
const email = site.contactEmail;
const isRealEmail = /^[^@\s[\]]+@[^@\s[\]]+\.[^@\s[\]]+$/.test(email);
---

<BaseLayout
  locale={locale}
  path={path}
  current={current}
  title={page.data.title}
  description={page.data.description}
  hasTwin={hasTwin}
  jsonLd={isAbout ? [personJsonLd(locale)] : []}
>
  <article class="page">
    <div class="g top">
      <div class="lab">
        <p class="crumb">
          <a href={pathFor(locale, "/")}>{t(locale, "crumbHome")}</a> / {page.data.title}
        </p>
        {isAbout && (
          <div class="portrait">
            <Photo tone={3} alt="[Portrait of Filippo Guanti: placeholder until the photograph is added]" />
            <ul class="contact">
              <li>{isRealEmail ? <a href={`mailto:${email}`}>{email}</a> : email}</li>
              <li>{site.city}</li>
            </ul>
          </div>
        )}
      </div>
      <div class="con">
        <h1 class="title">{page.data.title}</h1>
        <LanguageLabel locale={locale} originalLang={page.data.originalLang} rest={`/${slug}`} hasTwin={hasTwin} />
        <p class="stand">{page.data.description}</p>
      </div>
    </div>
    <div class="g">
      <div class="con">
        <div class="prose">
          <Content />
        </div>
        {slug === "now" && <p class="updated">{tf(locale, "nowUpdated", { date: isoDate(page.data.date) })}</p>}
      </div>
    </div>
  </article>
</BaseLayout>
