---
import LanguageLabel from "../components/LanguageLabel.astro";
import Photo from "../components/Photo.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
/**
 * Standalone pages: About, Now, Rights, Privacy (the page template in /styleguide). One grid for the head and the
 * text (decision 0025): the intro is the .lede of the journal and photos pages, and on About the portrait stands
 * beside both on desktop and between the intro and the text on phones and tablets.
 */
import { render } from "astro:content";
import site from "../data/site.json" with { type: "json" };
import { tf, type Locale } from "../i18n";
import { type PageEntry } from "../lib/collections.ts";
import { isoDate, pathFor } from "../lib/entries.ts";
import { SIZES } from "../lib/photo-sizes.ts";
import { portraitAlt, portraitImage, portraitKey } from "../lib/portrait.ts";
import { personJsonLd } from "../lib/seo.ts";

interface Props {
  locale: Locale;
  slug: string;
  page: PageEntry;
  hasTwin: boolean;
}

const { locale, slug, page, hasTwin } = Astro.props;
const { Content } = await render(page);
const path = pathFor(locale, `/${slug}`);
const current = slug === "now" || slug === "about" ? slug : undefined;
const isAbout = slug === "about";
// About and Now carry no "originally written in" label (decision 0023); the legal pages and entries do.
const showLabel = !(isAbout || slug === "now");
const email = site.contactEmail;
const isRealEmail = /^[^@\s[\]]+@[^@\s[\]]+\.[^@\s[\]]+$/.test(email);
---

<BaseLayout
  locale={locale}
  path={path}
  current={current}
  title={page.data.title}
  description={page.data.description}
  hasTwin={hasTwin}
  jsonLd={isAbout ? [personJsonLd(await portraitImage())] : []}
>
  <article class="page">
    <div class="g top top--intro">
      <h1 class="title">{page.data.title}</h1>
      {showLabel && (
        <LanguageLabel locale={locale} originalLang={page.data.originalLang} rest={`/${slug}`} hasTwin={hasTwin} />
      )}
      <p class="lede">{page.data.description}</p>
      {isAbout && (
        <div class="lab">
          <div class="portrait">
            <Photo tone={3} alt={portraitAlt(locale)} src={portraitKey} sizes={SIZES.portrait} priority />
            <ul class="contact">
              <li>{isRealEmail ? <a href={`mailto:${email}`}>{email}</a> : email}</li>
              <li>{site.city}</li>
            </ul>
          </div>
        </div>
      )}
      <div class="con">
        <div class="prose">
          <Content />
        </div>
        {slug === "now" && <p class="updated">{tf(locale, "nowUpdated", { date: isoDate(page.data.date) })}</p>}
      </div>
    </div>
  </article>
</BaseLayout>
