---
import Arrows from "../components/Arrows.astro";
import EntryTable from "../components/EntryTable.astro";
import MarkerLegend from "../components/MarkerLegend.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
/**
 * The journal index, by year, paginated at 50: /journal, /journal/page/2. Entries that exist in the other
 * language only are listed too, marked "IT only" / "solo EN".
 */
import { t, tf, type Locale } from "../i18n";
import { getSlots } from "../lib/collections.ts";
import { journalPath, paginate, rowsFor, type EntryLike, type Row } from "../lib/entries.ts";

interface Props {
  locale: Locale;
  page: number;
}

const { locale, page } = Astro.props;
const all = rowsFor(await getSlots(), locale) as Row<EntryLike>[];
const rows = all;
const paged = paginate(rows, page);
const years = [...new Set(paged.items.map((r) => r.slot.date.getUTCFullYear()))];
const heading = t(locale, "journalTitle");
const title = page > 1 ? `${heading} · ${tf(locale, "pageOf", { page, pages: paged.pages })}` : heading;
const path = journalPath(locale, page);
---

<BaseLayout locale={locale} path={path} current="journal" title={title} description={t(locale, "journalIntro")}>
  <div class="page">
    <div class="g hero hero--inner">
      <h1 class="state">{heading}</h1>
      <p class="lede">{t(locale, "journalIntro")}</p>
    </div>

    <div class="g sec">
      {/* An empty journal (no entries yet) has nothing for the legend to explain, so no label column at all. */}
      {rows.length > 0 && (
        <div class="lab">
          {page > 1 && <h2>{tf(locale, "pageOf", { page, pages: paged.pages })}</h2>}
          <MarkerLegend locale={locale} rows={paged.items} />
        </div>
      )}
      <div class="con">
        {rows.length === 0 && <p class="muted">{t(locale, "noEntries")}</p>}
        {years.map((year) => (
          <EntryTable
            locale={locale}
            rows={paged.items.filter((r) => r.slot.date.getUTCFullYear() === year)}
            caption={String(year)}
          />
        ))}
        {paged.pages > 1 && (
          <nav class="pager" aria-label={t(locale, "pagerNav")}>
            {page > 1 ? (
              <a class="go" rel="prev" href={journalPath(locale, page - 1)}>
                <Arrows text={t(locale, "newer")} />
              </a>
            ) : (
              <span />
            )}
            {page < paged.pages ? (
              <a class="go" rel="next" href={journalPath(locale, page + 1)}>
                <Arrows text={t(locale, "older")} />
              </a>
            ) : (
              <span />
            )}
          </nav>
        )}
      </div>
    </div>
  </div>
</BaseLayout>
