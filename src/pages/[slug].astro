---
import EntryView from "../views/EntryView.astro";
import PageView from "../views/PageView.astro";
import { slugPaths } from "../lib/routes.ts";

export async function getStaticPaths() {
  return slugPaths("en");
}

const props = Astro.props;
---

{props.kind === "entry" ? (
  <EntryView locale="en" item={props.item} />
) : (
  <PageView locale="en" slug={props.slug} page={props.page} hasTwin={props.hasTwin} />
)}
