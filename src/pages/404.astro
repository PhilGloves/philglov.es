---
import BaseLayout from "../layouts/BaseLayout.astro";
import { t } from "../i18n";
---

<BaseLayout
  locale="en"
  path="/404"
  title={`${t("en", "notFoundTitle")} · Filippo Guanti`}
  description={t("en", "notFoundBody")}
  hasTwin={false}
  noindex
>
  <div class="page">
    <div class="g hero">
      <div class="lab">
        <p class="err-code" aria-hidden="true">
          404
        </p>
      </div>
      <h1 class="state">{t("en", "notFoundTitle")}</h1>
      <p class="lede">
        {t("en", "notFoundBody")} <a href="/">{t("en", "goHome")}</a>
      </p>
    </div>
    <div class="g sec" lang="it">
      <div class="lab">
        <p class="mono muted">Italiano</p>
      </div>
      <div class="con">
        <h2 class="big">{t("it", "notFoundTitle")}</h2>
        <p class="lede">
          {t("it", "notFoundBody")} <a href="/it">{t("it", "goHome")}</a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
