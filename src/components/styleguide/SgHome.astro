---
import Arrows from "../Arrows.astro";
/** Home page pieces: hero, photograph, latest entry, journal table, Now band, photo grid, footer. */
import SiteFooter from "../SiteFooter.astro";
interface Props {
  theme: "light" | "dark";
}
const { theme } = Astro.props;
const rows = [
  {
    n: "041",
    date: "2026-10-09",
    title: "Why I shoot one roll a week",
    topic: "Photography",
    mark: "EN",
    min: "5",
    only: false,
  },
  {
    n: "040",
    date: "2026-09-27",
    title: "Rebuilding this site with almost no JavaScript",
    topic: "Projects",
    mark: "EN",
    min: "11",
    only: false,
  },
  {
    n: "039",
    date: "2026-09-12",
    title: "Notes on getting lost on purpose",
    topic: "Thoughts",
    mark: "IT→EN",
    min: "4",
    only: false,
  },
  {
    n: "038",
    date: "2026-08-30",
    title: "Un mese senza fotocamera nel telefono",
    topic: "Photography",
    mark: "IT only",
    min: "6",
    only: true,
  },
  {
    n: "037",
    date: "2026-08-14",
    title: "My grandmother’s recipe book and version control",
    topic: "Projects",
    mark: "IT→EN",
    min: "7",
    only: false,
  },
];
const shots = [
  { cls: "w2", tone: "tone-1", cap: "Lisbon · 2026" },
  { cls: "w1", tone: "tone-3", cap: "Vienna · 2026" },
  { cls: "w1", tone: "tone-4", cap: "Apennines · 2026" },
  { cls: "w2", tone: "tone-5", cap: "Rome · 2025" },
];
---

<div class="page">
  <div class="g hero">
    <div class="lab small">
      <p>
        <strong>Photographer and developer</strong>
      </p>
      <p class="muted">Based in [City]. Writing in English and Italian.</p>
    </div>
    <h3 class="state">
      <span class="kick">Filippo Guanti — journal, photographs, notes</span>Writing about photography, software, and{" "}
      <em>the places in between.</em>
    </h3>
    <p class="lede">
      Everything I do lives here. See what I’m focused on <a href="#sg-top">now</a>, read <a href="#sg-top">about me</a>
      , or start with the latest entry below.
    </p>
  </div>

  <figure class="photo">
    <div
      class="frame frame--hero tone-2"
      role="img"
      aria-label="Placeholder photograph, 21:9 on wide screens, 4:5 on phones"
    >
      <span aria-hidden="true">[ your best photograph ]</span>
    </div>
    <figcaption class="cap">
      <span>[Photo title] · [Place], [Year]</span>
      <a href="#sg-top">
        <Arrows text="All photos →" />
      </a>
    </figcaption>
  </figure>

  <div class="g sec">
    <div class="lab">
      <h3>Journal</h3>
      <p class="small muted">42 entries since 2025.</p>
      <p class="small muted">
        <span class="fine">
          <Arrows text="IT→EN" />
        </span>{" "}
        marks entries I wrote in Italian and translated myself.
      </p>
    </div>
    <div class="con">
      <div class="latest">
        <p class="latest-meta">
          <span>No. 042</span>
          <span>2026-10-21</span>
          <span>Travel</span>
          <b>
            <Arrows text="IT→EN" />
          </b>
        </p>
        <h3>
          <a href="#sg-top">Three weeks in Lisbon, mostly on foot</a>
        </h3>
        <div class="ex">
          <p>
            I had a plan when I arrived and none when I left. The plan was a list of viewpoints; what I actually did was
            walk until my feet chose the route.
          </p>
          <a class="go" href="#sg-top">
            <Arrows text="Read · 8 min →" />
          </a>
        </div>
      </div>
      <table class="idx">
        <caption>Earlier entries</caption>
        <thead>
          <tr>
            <th scope="col">No.</th>
            <th scope="col">Date</th>
            <th scope="col">Title</th>
            <th scope="col" class="tp">
              Topic
            </th>
            <th scope="col">Lang</th>
            <th scope="col" class="mn">
              Min
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((e) => (
            <tr>
              <td class="n">{e.n}</td>
              <td class="dt">{e.date}</td>
              <td class="t">
                <a href="#sg-top">{e.title}</a>
              </td>
              <td class="tp">{e.topic}</td>
              <td class="ln">
                <span class:list={{ only: e.only }}>
                  <Arrows text={e.mark} />
                </span>
              </td>
              <td class="mn">{e.min}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="idx-more">
        <a class="go" href="#sg-top">
          <Arrows text="Full index, by year and topic →" />
        </a>
      </p>
    </div>
  </div>
</div>

<div class="band">
  <div class="page g">
    <div class="lab">
      <h3>Now</h3>
      <p class="small fine">Updated 2026-10-29</p>
    </div>
    <div class="con">
      <p>
        [Where you are and what you’re making this month, in one or two sentences.] Reading [book]. Shooting [project]
        on [camera].
      </p>
      <a class="small" href="#sg-top">
        <Arrows text="More on /now →" />
      </a>
    </div>
  </div>
</div>

<div class="page">
  <div class="g sec">
    <div class="lab">
      <h3>Photos</h3>
      <p class="small muted">
        4 series ·{" "}
        <a class="go" href="#sg-top">
          <Arrows text="See all →" />
        </a>
      </p>
    </div>
    <div class="con">
      <ul class="shots">
        {shots.map((p) => (
          <li class={p.cls}>
            <figure>
              <a href="#sg-top">
                <div class={`frame ${p.tone}`} role="img" aria-label="Placeholder photograph">
                  <span aria-hidden="true">[ photo ]</span>
                </div>
              </a>
              <figcaption>{p.cap}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<SiteFooter locale="en" flat demo idPrefix={`sg-home-${theme}`} />
