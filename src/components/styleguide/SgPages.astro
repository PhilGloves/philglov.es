---
/** Page templates: Now, About, the legal pages' prose, the 404. */
---

<div class="page">
  <div class="g top">
    <div class="lab">
      <p class="crumb">
        <a href="#sg-top">Filippo Guanti</a> / About
      </p>
      <div class="portrait">
        <div class="frame tone-3" role="img" aria-label="Placeholder portrait">
          <span aria-hidden="true">[ portrait ]</span>
        </div>
        <ul class="contact">
          <li>[email]</li>
          <li>[city]</li>
        </ul>
      </div>
    </div>
    <div class="con">
      <h2 class="title">About Filippo Guanti</h2>
      <p class="stand">Photographer and developer, writing in English and Italian.</p>
    </div>
  </div>
  <div class="g">
    <div class="con">
      <div class="prose">
        <p>[Two or three sentences of bio.] This is the page template shared by About, Now, Rights and Privacy.</p>
        <h2>Rights and reuse</h2>
        <p>
          Everything here is © Filippo Guanti, all rights reserved. <a href="#sg-top">Read the full notice.</a>
        </p>
      </div>
      <p class="updated">Updated 2026-10-29</p>
    </div>
  </div>

  <div class="g sec">
    <div class="lab">
      <p class="err-code" aria-hidden="true">
        404
      </p>
    </div>
    <div class="con">
      <h3 class="title">Page not found</h3>
      <p class="stand">
        There is nothing at this address. <a href="#sg-top">Go to the home page</a>
      </p>
    </div>
  </div>
</div>
