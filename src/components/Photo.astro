---
/**
 * A photograph in a .frame. With an original in src/.originals it draws a
 * <picture>: AVIF + WebP + JPEG, with smaller variants for the About portrait, width and
 * height always set, lazy except the one `priority` image per page, and the
 * photo's dominant colour as the box background through a generated class
 * (never an inline style: the CSP blocks those). Photos that have art direction
 * (photos.json `art`) get one <source media> per breakpoint. Without an
 * original it draws the tone placeholder, so the site builds before any photo
 * is uploaded (ticket P2). With `large` (the link text) and a real original, the photo is a plain link to its
 * watermarked large version (src/lib/large-photo.ts, decision 0043); a placeholder or a grey stand-in gets none.
 */
import { Picture, getImage } from "astro:assets";
import { colourClass } from "../../scripts/lib/photo-meta.ts";
import { largePhoto } from "../lib/large-photo.ts";
import { originals, records } from "../lib/photo-meta.ts";
import { JPEG_QUALITY, LARGE_EDGE } from "../lib/watermark.ts";

type Gravity =
  "center" | "top" | "bottom" | "left" | "right" | "top left" | "top right" | "bottom left" | "bottom right";
type Crop = { file: string } | { ratio: string; position: Gravity };
interface Art {
  desktop?: Crop | undefined;
  tablet?: Crop | undefined;
  mobile?: Crop | undefined;
}

interface Props {
  tone: number;
  /** Alt text in the page's language: what is in it and why it matters. */
  alt: string;
  ratio?: "hero" | "wide" | "fig" | "tall" | "land" | "auto" | undefined;
  /** Key of the original, "photos/<series>/<file>"; undefined draws the placeholder. */
  src?: string | undefined;
  art?: Art | undefined;
  /** The `sizes` attribute for the layout this photo sits in. */
  sizes?: string | undefined;
  /** The first image on the page: eager and fetchpriority high. All others are lazy. */
  priority?: boolean | undefined;
  /** The About portrait is displayed at no more than 256 CSS px. */
  portrait?: boolean | undefined;
  /** The link text after the alt text ("Open the large version"): the photo links to its large version. */
  large?: string | undefined;
}

const { tone, alt, ratio, src, art, sizes = "100vw", priority = false, portrait = false, large } = Astro.props;

const WIDTHS = portrait ? [256, 512, 768] : [480, 800, 1200, 1600, 2400];
// The plain <img>'s own file: the largest published width, never the original's size (final review T3-01). Without
// a width, Astro writes that file at the original's full size, a print-quality copy in the page source.
const LARGEST = Math.max(...WIDTHS);
// No file is longer than LARGE_EDGE on either side either: a tall photo 2400 px wide would be 3600 px high (0043).
const maxWidth = (width: number, height: number): number =>
  Math.min(LARGEST, Math.floor((LARGE_EDGE * width) / Math.max(width, height)));
const capped = (width: number, height: number): number => Math.min(width, maxWidth(width, height));
const widthsFor = (width: number, height: number): number[] => {
  const max = maxWidth(width, height);
  return max >= LARGEST ? WIDTHS : [...WIDTHS.filter((w) => w < max), max];
};
const QUALITY = { avif: 55, webp: 70, jpeg: JPEG_QUALITY } as const;
const record = src ? records[src] : undefined;
const load = src ? originals[src] : undefined;
const meta = record && load ? (await load()).default : undefined;
const seriesDir = src ? src.slice(0, src.lastIndexOf("/") + 1) : "";

async function cropSource(crop: Crop | undefined) {
  if (!meta) return undefined;
  if (crop && "file" in crop) {
    const other = originals[`${seriesDir}${crop.file}`];
    return other ? { image: (await other()).default, fit: undefined, position: undefined } : undefined;
  }
  if (crop) {
    const [rw, rh] = crop.ratio.split(":").map(Number) as [number, number];
    const width = Math.min(meta.width, Math.round((meta.height * rw) / rh));
    const height = Math.round((width * rh) / rw);
    return { image: meta, width, height, fit: "cover" as const, position: crop.position };
  }
  return { image: meta, fit: undefined, position: undefined };
}

const FORMATS = [
  ["avif", "image/avif"],
  ["webp", "image/webp"],
] as const;

/** One <source> per format for a breakpoint's crop. */
async function sourcesFor(crop: Crop | undefined, media: string | undefined) {
  const c = await cropSource(crop);
  if (!c) return [];
  return Promise.all(
    FORMATS.map(async ([format, type]) => {
      const img = await getImage({
        src: c.image,
        format,
        layout: "none",
        widths: c.fit ? widthsFor(c.width, c.height) : widthsFor(c.image.width, c.image.height),
        sizes,
        quality: QUALITY[format],
        ...(c.fit && { width: c.width, height: c.height, fit: c.fit, position: c.position }),
      });
      return {
        media,
        type,
        srcset: img.srcSet.attribute,
        width: img.attributes["width"],
        height: img.attributes["height"],
      };
    }),
  );
}

const directed = art && (art.mobile || art.tablet || art.desktop);
const sources = directed
  ? [
      ...(art.mobile ? await sourcesFor(art.mobile, "(max-width: 40rem)") : []),
      ...(art.tablet ? await sourcesFor(art.tablet, "(max-width: 65rem)") : []),
      ...(await sourcesFor(art.desktop, "")),
    ]
  : [];
const fallback = directed ? await cropSource(art.desktop) : undefined;
const fallbackImg =
  directed && fallback
    ? await getImage({
        src: fallback.image,
        format: "jpeg",
        layout: "none",
        widths: fallback.fit
          ? widthsFor(fallback.width, fallback.height)
          : widthsFor(fallback.image.width, fallback.image.height),
        sizes,
        quality: QUALITY.jpeg,
        ...(fallback.fit
          ? {
              // The crop at its ratio, scaled down to the largest published width.
              width: capped(fallback.width, fallback.height),
              height: Math.round((fallback.height * capped(fallback.width, fallback.height)) / fallback.width),
              fit: fallback.fit,
              position: fallback.position,
            }
          : { width: capped(fallback.image.width, fallback.image.height) }),
      })
    : undefined;

const boxClass = ["frame", ratio && `frame--${ratio}`, record ? colourClass(record.colour) : `tone-${tone}`];
const placeholderClass = ratio === "auto" ? [...boxClass.slice(0, 1), "frame--land", ...boxClass.slice(2)] : boxClass;
const loading = priority ? "eager" : "lazy";
const largeSrc = large && !directed ? await largePhoto(src) : undefined;
const Link = largeSrc ? "a" : Fragment;
---

{meta && !directed ? (
  <Link {...(largeSrc && { class: "large", href: largeSrc })}>
    <div class:list={boxClass}>
      <Picture
        src={meta}
        alt={alt}
        formats={["avif", "webp"]}
        fallbackFormat="jpeg"
        widths={widthsFor(meta.width, meta.height)}
        width={capped(meta.width, meta.height)}
        layout="none"
        sizes={sizes}
        quality={QUALITY.jpeg}
        loading={loading}
        fetchpriority={priority ? "high" : "auto"}
        decoding="async"
      />
    </div>
    {largeSrc && <span class="sr-only">{large}</span>}
  </Link>
) : meta && directed && fallbackImg ? (
  <div class:list={boxClass}>
    <picture>
      {sources.map((s) => (
        <source
          media={s.media || undefined}
          type={s.type}
          srcset={s.srcset}
          sizes={sizes}
          width={s.width}
          height={s.height}
        />
      ))}
      <img
        src={fallbackImg.src}
        srcset={fallbackImg.srcSet.attribute}
        sizes={sizes}
        width={fallbackImg.attributes["width"]}
        height={fallbackImg.attributes["height"]}
        alt={alt}
        loading={loading}
        fetchpriority={priority ? "high" : "auto"}
        decoding="async"
      />
    </picture>
  </div>
) : (
  <div class:list={placeholderClass} role="img" aria-label={alt}>
    <span aria-hidden="true">[ photo ]</span>
  </div>
)}
