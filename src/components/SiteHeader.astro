---
/**
 * Header and main navigation: name with the domain beneath, the four links,
 * the language switch ("IT"/"EN") and the theme toggle (a moon in light mode, a sun in dark mode: both inline SVG,
 * CSS shows one, and with it one of two visually hidden labels; decisions 0023, 0028), as two round controls. One row on desktop; from tablet
 * down the name and controls sit above the links. No menu button.
 * `demo` renders the same markup without landmarks, for /styleguide.
 */
import { t, twinPath, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  /** This page's path without a trailing slash, e.g. "/" or "/it/alps". */
  path: string;
  /** Whether the other-language twin of this page exists. */
  hasTwin?: boolean;
  current?: "journal" | "photos" | "now" | "about" | undefined;
  demo?: boolean;
}

const { locale, path, hasTwin = true, current, demo = false } = Astro.props;
const other: Locale = locale === "en" ? "it" : "en";
const prefix = locale === "en" ? "" : "/it";
const home = locale === "en" ? "/" : "/it";
const switchHref = hasTwin ? twinPath(locale, path) : twinPath(locale, home);
const links = [
  { key: "journal", href: `${prefix}/journal`, label: t(locale, "navJournal") },
  { key: "photos", href: `${prefix}/photos`, label: t(locale, "navPhotos") },
  { key: "now", href: `${prefix}/now`, label: t(locale, "navNow") },
  { key: "about", href: `${prefix}/about`, label: t(locale, "navAbout") },
] as const;
// The visible text is the language code; the name starts with it (WCAG 2.5.3, BUG-1) and goes on with the whole
// language name, in that language, plus the note when this page has no twin (the link then opens the other home page).
const switchName =
  `${other.toUpperCase()}, ${t(locale, "otherLanguageName")}` +
  (!hasTwin && !demo ? ` — ${t(locale, "switchNoTwin")}` : "");
const Header = demo ? "div" : "header";
const Nav = demo ? "div" : "nav";
---

<div class="page">
  <Header class="head">
    <p class="name">
      <a href={demo ? "#" : home}>
        <b>Filippo Guanti</b>
        <span>philglov.es</span>
      </a>
    </p>
    <Nav class="nav" aria-label={demo ? undefined : t(locale, "navLabel")}>
      <ul>
        {links.map((link) => (
          <li>
            <a href={demo ? "#" : link.href} aria-current={link.key === current ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </Nav>
    <div class="tools">
      <a class="rbtn lang-switch" href={demo ? "#" : switchHref} hreflang={other} lang={other} aria-label={switchName}>
        {other.toUpperCase()}
      </a>
      <button type="button" class="rbtn theme-toggle" data-theme-toggle>
        <span class="sr-only to-dark">{t(locale, "themeToDark")}</span>
        <span class="sr-only to-light">{t(locale, "themeToLight")}</span>
        <svg
          class="i-moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
        </svg>
        <svg
          class="i-sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"></path>
        </svg>
      </button>
    </div>
  </Header>
</div>
