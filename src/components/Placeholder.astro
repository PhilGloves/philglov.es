---
import { t, twinPath, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const other: Locale = locale === "en" ? "it" : "en";
const otherHome = twinPath(locale, locale === "en" ? "/" : "/it");
---

<div class="page">
  <div class="g hero">
    <div class="lab">
      <p class="mono muted">
        {t(locale, "writtenIn")} ·{" "}
        <a href={otherHome} hreflang={other} lang={other}>
          {t(locale, "readOther")}
        </a>
      </p>
    </div>
    <h1 class="state">Filippo Guanti</h1>
    <p class="lede">{t(locale, "placeholder")}</p>
  </div>
</div>
