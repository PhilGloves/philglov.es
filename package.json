{
  "name": "philglov-es",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "check:content": "node scripts/check-content.ts",
    "new": "node scripts/new.ts",
    "build": "node scripts/check-content.ts && node scripts/photo-meta.ts && astro build && node scripts/share-images.ts && node scripts/photo-rights.ts && node scripts/postbuild.ts",
    "preview": "node scripts/preview.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "wrangler types worker/worker-configuration.d.ts && astro check && tsc -p worker && tsc -p tests/worker",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun",
    "test": "pnpm test:unit && pnpm test:worker && pnpm test:e2e",
    "deploy:staging": "wrangler deploy --env staging",
    "test:worker": "vitest run",
    "photos:fetch": "node scripts/fetch-originals.ts"
  },
  "dependencies": {
    "astro": "7.4.8",
    "jose": "6.2.17",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/vitest-plugin": "1.6.1",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "html-validate": "11.21.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "wrangler": "4.159.0"
  }
}
